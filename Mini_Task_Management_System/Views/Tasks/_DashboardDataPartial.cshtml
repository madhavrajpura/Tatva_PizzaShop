@model DataAccessLayer.ViewModels.TaskItemViewModel;

<!-- Card 1 -->
<div class="col-12 mt-2 col-sm-6 col-lg-3 ">
    <div class=" shadow p-2 h-100" style="border-radius: 7px !important; background-color: rgb(255, 255, 255);">
        <div class="d-flex justify-content-center p-1">
            <h2 class="text-left fs-4 custom-text-color">Pending Tasks</h2>
        </div>
        <div class="d-flex justify-content-center p-1">
            <span class="fs-4 fw-bold">@Model.PendingCount</span>
        </div>
    </div>
</div>

<!-- Card 2 -->
<div class="col-12 mt-2 col-sm-6 col-lg-3 ">
    <div class=" shadow p-2 h-100" style="border-radius: 7px !important; background-color: rgb(255, 255, 255);">
        <div class="d-flex justify-content-center p-1">
            <h2 class="text-left fs-4 custom-text-color">Completed Tasks</h2>
        </div>
        <div class="d-flex justify-content-center p-1">
            <span class="fs-4 fw-bold">@Model.CompletedCount</span>
        </div>
    </div>
</div>