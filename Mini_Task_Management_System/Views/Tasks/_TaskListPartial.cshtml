@using DataAccessLayer.ViewModels
@model PaginationViewModel<TaskItemViewModel>

@if (Model.Items.Count == 0)
{
    <tr>
        <td colspan="6" class="text-center text-danger fw-bold">No Records Found</td>
    </tr>
}
else
{
    @foreach (var item in Model.Items)
    {
        <tr class="border border-end-0 border-start-0 border-top-0 border-bottom-1">
            <td class="text-nowrap">@item.Title</td>
            <td class="text-nowrap">@item.DueDate.ToString("yyyy/MM/dd")</td>
            <td class="text-nowrap">
                @if (item.IsCompleted)
                {
                    <span class="badge bg-success fw-lighter">Completed</span>
                }
                else
                {
                    <span class="badge fw-lighter text-black" style="background-color: rgb(255, 245, 155);">Pending</span>
                }
            </td>
            <td class="text-nowrap"><span class="badge fw-lighter text-black"
                    style="background-color: rgb(255, 245, 155);">@item.CategoryName</span></td>
            <td class="text-nowrap"><span class="badge fw-lighter text-black"
                    style="background-color: rgb(255, 245, 155);">@item.PriorityName</span></td>
            <td class="text-start">
                <i class="fa-solid fa-pen text-black-50 me-3 SaveTaskId" data-bs-toggle="modal" data-bs-target="#SaveTaskModal"
                    data-id="@item.Id"></i>
                <i class="fa-solid fa-trash-can text-black-50" data-bs-toggle="modal" data-bs-target="#DeleteTaskModal"
                    data-id="@item.Id" onclick=GetIdForDeleteTask(this)></i>
            </td>
        </tr>
    }
}
<input type="hidden" id="totalRecords" value="@Model.TotalCount" />